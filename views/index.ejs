<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Welcome to EduShare</title>

    <link rel="icon" type="image/png" href="/images/favicon.png" />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/style.css" />

    <style>
      .main-login {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        padding: 0%;
      }

      img {
        height: 100%;
        border-radius: 6%;
      }
    </style>
  </head>

  <body>
    <main class="main-login" style="height: 80vh">
      <img class="signInImage" src="/images/Welcome.png" alt="Example Image" />

      <div style="padding: 35px">
        <h1>Welcome to EduShare 📖</h1>

        <p>
          Welcome to your dedicated platform for sharing educational materials!
          Connect with passionate learners and inspiring teachers as we grow
          knowledge together. Join us on this exciting journey of discovery and
          learning! Let’s explore, share, and celebrate knowledge—every step of
          the way! Start your learning adventure with us today!
        </p>

        <div style="padding: 10px">
          <a
            href="/login"
            class="button"
            role="button"
            aria-label="Start your journey and go to login page"
          >
            Start Your Journey
          </a>
        </div>

        <h4 style="padding-top: 10px">
          EduShare is not just an app; it’s a community of learners!
        </h4>

        <br />

        <div style="padding: 10px">
          <a
            href="/AboutUs"
            class="button"
            role="button"
            aria-label="Discover our story and learn more about EduShare"
          >
            <pre>   Learn About Us    </pre>
          </a>
        </div>
      </div>
    </main>

    <footer>&copy; 2023 EduShare. All rights reserved.</footer>
  </body>
</html>
